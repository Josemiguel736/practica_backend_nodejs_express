{
  "name": "nodepop",
  "version": "1.0.0",
  "description": "practica modulo backend con nodeJS de keepcoding",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:module": "jest",
    "test:watch": "jest --watch",
    "start": "cross-env NODEPOP_ENV=production npx pm2 start server.js && npx pm2 start consumerThumbnail.js && npx pm2 monit",
    "dev": "cross-env DEBUG=nodepop:* NODEPOP_ENV=development nodemon server.js",
    "devInit": "cross-env DEBUG=nodepop:* NODEPOP_ENV=development npx pm2 start consumerThumbnail.js && nodemon server.js && npx pm2 stop all ",
    "stop": "npx pm2 stop all",
    "delete": "npx pm2 delete all",
    "restart": "npx pm2 restart all",
    "initDB": "node initDB.js",
    "lint": "npx standard ",
    "lintFix": "npx standard --fix ",
    "cleanImg": "node cleanImages.js",
    "initDBandClean": "npm run initDB && npm run cleanImg"
  },
  "author": "José Miguel Atiénzar",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.5",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cross-env": "^7.0.3",
    "debug": "^4.3.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "fs": "^0.0.1-security",
    "http-errors": "^2.0.0",
    "i18n": "^0.15.1",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.7",
    "pm2": "^5.4.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.7",
    "@babel/preset-env": "^7.26.7",
    "@types/jest": "^29.5.14",
    "babel-jest": "^29.7.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "standard": "^17.1.2"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ]
  },
  "standard": {
    "env": [
      "jest"
    ],
    "ignores": [
      "./user.test.js"
    ]
  }
}
